    {"id":"title","type":"text","x":60,"y":32,"width":1500,"height":48,"text":"Workbench infra choice: do not choose a machine, choose a lifecycle","originalText":"Workbench infra choice: do not choose a machine, choose a lifecycle","fontSize":34,"fontFamily":3,"strokeColor":"#1e40af","backgroundColor":"transparent","lineHeight":1.25},
