    {"id":"title","type":"text","x":40,"y":30,"width":1300,"height":50,"text":"How to beat Replicas: don’t clone the surface area, win the weak layer","originalText":"How to beat Replicas: don’t clone the surface area, win the weak layer","fontSize":32,"fontFamily":3,"strokeColor":"#0f172a","backgroundColor":"transparent","lineHeight":1.25},
    {"id":"sub","type":"text","x":42,"y":78,"width":1400,"height":28,"text":"Replicas is strong at cloud sandboxes + workflow integrations. The opening is trust, verification, setup pain, and cost.","originalText":"Replicas is strong at cloud sandboxes + workflow integrations. The opening is trust, verification, setup pain, and cost.","fontSize":18,"fontFamily":3,"strokeColor":"#64748b","backgroundColor":"transparent","lineHeight":1.25},

    {"id":"rep_box","type":"rectangle","x":70,"y":150,"width":360,"height":245,"strokeColor":"#2563eb","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"roughness":0,"roundness":{"type":3}},
    {"id":"rep_title","type":"text","x":95,"y":175,"width":310,"height":30,"text":"Replicas core moat","originalText":"Replicas core moat","fontSize":23,"fontFamily":3,"strokeColor":"#1d4ed8","backgroundColor":"transparent","lineHeight":1.25},
    {"id":"rep_body","type":"text","x":95,"y":222,"width":310,"height":140,"text":"• SaaS VM sandboxes\n• GitHub/Slack/Linear/GitLab\n• warm pools + envs + MCPs\n• BYO Claude/Codex/Cursor\n• PR feedback + CI loops","originalText":"• SaaS VM sandboxes\n• GitHub/Slack/Linear/GitLab\n• warm pools + envs + MCPs\n• BYO Claude/Codex/Cursor\n• PR feedback + CI loops","fontSize":17,"fontFamily":3,"strokeColor":"#334155","backgroundColor":"transparent","lineHeight":1.35},

