    {"id":"wedge_title","type":"text","x":1050,"y":175,"width":370,"height":60,"text":"Verification-first, self-hostable\nbackground agents","originalText":"Verification-first, self-hostable\nbackground agents","fontSize":23,"fontFamily":3,"strokeColor":"#047857","backgroundColor":"transparent","lineHeight":1.25},
