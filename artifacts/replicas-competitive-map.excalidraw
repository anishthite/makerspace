    {"id":"gap_title","type":"text","x":545,"y":175,"width":360,"height":30,"text":"Best attack surface","originalText":"Best attack surface","fontSize":23,"fontFamily":3,"strokeColor":"#b91c1c","backgroundColor":"transparent","lineHeight":1.25},
    {"id":"gap_body","type":"text","x":545,"y":222,"width":350,"height":140,"text":"• $120–$300/seat is high\n• closed-source SaaS trust gap\n• first repo setup is fiddly\n• quality still brief/verify-bound\n• true auto-merge confidence absent","originalText":"• $120–$300/seat is high\n• closed-source SaaS trust gap\n• first repo setup is fiddly\n• quality still brief/verify-bound\n• true auto-merge confidence absent","fontSize":17,"fontFamily":3,"strokeColor":"#334155","backgroundColor":"transparent","lineHeight":1.35},

