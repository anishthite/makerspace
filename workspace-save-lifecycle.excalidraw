    {"id":"title","type":"text","x":60,"y":34,"width":1350,"height":48,"text":"Persistent workspace save model: stop is not delete","originalText":"Persistent workspace save model: stop is not delete","fontSize":34,"fontFamily":3,"strokeColor":"#1e40af","backgroundColor":"transparent","lineHeight":1.25},
    {"id":"subtitle","type":"text","x":62,"y":84,"width":1380,"height":28,"text":"On normal autostop, the Daytona/VPS disk persists. You only export before reset/delete or cross-provider migration.","originalText":"On normal autostop, the Daytona/VPS disk persists. You only export before reset/delete or cross-provider migration.","fontSize":18,"fontFamily":3,"strokeColor":"#64748b","backgroundColor":"transparent","lineHeight":1.25},

