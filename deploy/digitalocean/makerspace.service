[Unit]
Description=Makerspace control backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/makerspace
EnvironmentFile=/etc/makerspace.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
User=makerspace
Group=makerspace

[Install]
WantedBy=multi-user.target
